const f = formen[art];
---
<svg class="zeichen" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <path class="zeichen__strich" pathLength="1" d={f.strich} />
  <path class="zeichen__blau" pathLength="1" d={f.blau} />
</svg>
