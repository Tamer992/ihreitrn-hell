  },
  hoerer: {
    strich: 'M20 10 C14 10 10 15 10 21 C10 40 24 54 43 54 C49 54 54 50 54 44 L54 40 L44 35 L39 41 C31 38 26 33 23 25 L29 20 L24 10 Z',
    blau: 'M38 10 C46 11 53 18 54 26 M37 17 C42 18 46 22 47 27',
  },
  buero: {
    strich: 'M8 46 H56 M14 46 V22 H50 V46 M26 46 V54 M38 46 V54 M20 54 H44',
    blau: 'M20 30 H34 M20 37 H44',
  },
  rechnung: {
